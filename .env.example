DATABASE_URL=mysql+pymysql://moyo:moyo_password@127.0.0.1:3306/moyo_memory?charset=utf8mb4
MODEL_API_KEY=
MODEL_NAME=qwen3.8-max
MODEL_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
MODEL_ENABLE_THINKING=true
MODEL_TIMEOUT_SECONDS=60
MEMORY_EXTRACTION_MAX_ATTEMPTS=3
MEMORY_MIN_CONFIDENCE=0.72
RECALL_MIN_SCORE=0.35
RECALL_RELATIVE_SCORE_THRESHOLD=0.55
RECALL_AUTO_CATEGORY_FILTER=true

# Dedicated Qwen text reranking. RERANK_API_KEY can be blank to reuse MODEL_API_KEY.
RERANK_ENABLED=false
RERANK_MODEL=qwen3.7-text-rerank
RERANK_ENDPOINT=https://maas.qianwenaiapi.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_MIN_SCORE=0.20
RERANK_MAX_CANDIDATES=24
RERANK_TIMEOUT_SECONDS=20

# API authorization. Keep disabled only for local development.
# User routes require X-User-ID; admin routes require X-Admin-Key when enabled.
AUTH_ENABLED=false
AUTH_ADMIN_KEY=

# Conversation context. A turn is one user/assistant exchange.
CHAT_HISTORY_MAX_TURNS=12
CHAT_CONTEXT_MAX_TOKENS=16000
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_TEMPERATURE=0.3
CHAT_SUMMARY_ENABLED=true

# Semantic recall. The embedding provider must expose an OpenAI-compatible /embeddings API.
SEMANTIC_RECALL_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=moyo_memory_facts_v1
QDRANT_TIMEOUT_SECONDS=3
SEMANTIC_FAILURE_THRESHOLD=3
SEMANTIC_COOLDOWN_SECONDS=30
VECTOR_INDEX_BATCH_SIZE=64
VECTOR_INDEX_MAX_ATTEMPTS=8

