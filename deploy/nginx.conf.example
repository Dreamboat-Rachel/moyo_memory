# Include this inside nginx's http {} block. Configure the real client IP only
# from explicitly trusted load balancers before using per-IP rate limits.
limit_req_zone $binary_remote_addr zone=moyo_api_per_ip:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=moyo_conn_per_ip:10m;

server {
    listen 443 ssl;
    server_name memory.example.com;

    ssl_certificate /etc/letsencrypt/live/memory.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/memory.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;
    client_body_timeout 15s;
    send_timeout 120s;

    location / {
        limit_req zone=moyo_api_per_ip burst=30 nodelay;
        limit_req_status 429;
        limit_conn moyo_conn_per_ip 20;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }
}
