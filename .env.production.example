# Copy to .env.production, replace every secret, and restrict file permissions.
APP_ENV=production
DATABASE_URL=mysql+pymysql://moyo:replace-with-url-encoded-password@mysql:3306/moyo_memory?charset=utf8mb4
MYSQL_DATABASE=moyo_memory
MYSQL_USER=moyo
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

MODEL_API_KEY=replace-with-provider-key
MODEL_NAME=qwen3.8-max
MODEL_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
MODEL_ENABLE_THINKING=true
MODEL_TIMEOUT_SECONDS=60

AUTH_ENABLED=true
AUTH_ADMIN_KEY=replace-with-at-least-32-random-characters
AUTH_USER_SIGNING_KEY=replace-with-a-different-32-character-secret
AUTH_SIGNATURE_TTL_SECONDS=300

SEMANTIC_RECALL_ENABLED=true
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_DIMENSIONS=1024
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-different-long-random-secret

RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
RERANK_ENDPOINT=https://maas.qianwenaiapi.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_MIN_SCORE=0.20
RERANK_MAX_CANDIDATES=24
RERANK_TIMEOUT_SECONDS=20
